# Copy this file to .env and fill in your credentials

# SMS through Gmail and your carrier's email-to-SMS gateway.
# Set these directly, or point to a compatible shared JSON configuration.
SMS_ENABLED=true
SMS_PHONE_NUMBER=5551234567
SMS_CARRIER=vtext.com
SMS_GMAIL_USER=your_gmail_address
SMS_GMAIL_APP_PASSWORD=your_gmail_app_password
# SMS_CONFIG_PATH=Q:\path\to\shared-config.json

# Reddit API (required for sentiment tracking)
# Get from https://www.reddit.com/prefs/apps
REDDIT_ENABLED=true
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# Optional source; automatically pauses for a run after HTTP 429.
TRENDS_ENABLED=true
